+// Window hit test: the title bar drags the window (SDL moves it natively), except the close box
+// which stays a normal click. Content and fullscreen are always normal. Coordinates are window
+// pixels; the borderless themed window is created at logical size (scale 1) so they match the
+// logical chrome/close-box rects.
+static SDL_HitTestResult SDLCALL RetroMacHitTest(SDL_Window * /*win*/, const SDL_Point *area, void * /*data*/)
+{
+	if (RetroMacChromeH <= 0 || area->y >= RetroMacChromeH) {

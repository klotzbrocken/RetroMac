{
  "schemaVersion": 2,
  "id": "com.retromac.microsoft.windows7",
  "family": {
    "id": "microsoft",
    "name": "Microsoft Windows",
    "order": 2
  },
  "release": {
    "label": "Windows 7",
    "year": 2009
  },
  "experienceLevel": "full",
  "chrome": {
    "style": "win7"
  },
  "name": "Windows 7",
  "hideMenuBarDefault": true,
  "version": "1.0",
  "author": "RetroMac",
  "splashScreen": "splash.png",
  "splashFullscreen": true,
  "wallpaper": "wallpaper.jpg",
  "wallpapers": [
    {
      "name": "Harmony",
      "file": "wallpaper.jpg"
    },
    {
      "name": "Light Trails",
      "file": "wallpaper2.jpg"
    },
    {
      "name": "Beach",
      "file": "wallpaper3.jpg"
    }
  ],
  "dock": {
    "height": 40,
    "iconSize": 32,
    "padding": 6,
    "spacing": 4,
    "cornerRadius": 0,
    "backgroundColor": "#C9D4DE80",
    "backgroundGradientTop": "#E8EFF480",
    "backgroundGradientBottom": "#B2C0CC80",
    "backgroundImage": null,
    "backgroundImageMode": "tile",
    "borderColor": "#7E8E9EFF",
    "borderWidth": 0,
    "shadowEnabled": false,
    "shadowColor": "#00000000",
    "shadowRadius": 0,
    "bevelTopColor": "#FFFFFFFF",
    "bevelBottomColor": "#7C8A98FF",
    "bevelWidth": 0,
    "orientation": "horizontal",
    "position": "bottom",
    "fullWidth": true,
    "startButton": true,
    "startButtonLabel": "",
    "showClock": true,
    "magnification": false,
    "showTrash": false,
    "startMenuStyle": "xp",
    "gradientTop": "#E8EFF4FF",
    "gradientBottom": "#B2C0CCFF",
    "startButtonImage": "startwin7.png"
  },
  "icon": {
    "renderStyle": "smooth",
    "reflectionEnabled": false,
    "reflectionOpacity": 0,
    "hoverScale": 1.0,
    "hoverAnimationDuration": 0.08
  },
  "indicator": {
    "style": "highlight",
    "color": "#5B9BD5",
    "size": 3,
    "offset": 2
  },
  "desktopIconsSide": "left",
  "desktopIcons": [
    {
      "name": "Computer",
      "icon": "win7_computer.png",
      "type": "folder",
      "path": "/",
      "gridX": 0,
      "gridY": 0
    },
    {
      "name": "All Programs",
      "icon": "xp_documents.png",
      "type": "appfolder",
      "gridX": 0,
      "gridY": 1
    },
    {
      "name": "Recycle Bin",
      "icon": "win7_recycle_empty.png",
      "iconFull": "win7_recycle_full.png",
      "type": "trash",
      "gridX": 0,
      "gridY": 2
    },
    {
      "name": "CPU",
      "icon": "proz_xp.png",
      "type": "cpumonitor",
      "gridX": 0,
      "gridY": 3
    },
    {
      "name": "Internet Explorer",
      "icon": "win7_ie.png",
      "type": "webapp",
      "url": "https://98.js.org/programs/explorer/index.html?address=https%3A%2F%2Fwww.amazon.com",
      "args": [
        "1020",
        "740"
      ],
      "gridX": 0,
      "gridY": 4
    },
    {
      "name": "Notepad",
      "icon": "win7_notepad.png",
      "type": "notepad",
      "gridX": 0,
      "gridY": 5
    },
    {
      "name": "Paint",
      "icon": "win7_paint.png",
      "type": "webapp",
      "url": "https://98.js.org/programs/jspaint/index.html",
      "args": [
        "920",
        "640"
      ],
      "gridX": 0,
      "gridY": 6
    },
    {
      "name": "Minesweeper",
      "icon": "win7_mines.png",
      "type": "webapp",
      "url": "https://98.js.org/programs/minesweeper/index.html",
      "args": [
        "360",
        "460"
      ],
      "gridX": 1,
      "gridY": 0
    },
    {
      "name": "Solitaire",
      "icon": "win7_solitaire.png",
      "type": "webapp",
      "url": "https://98.js.org/programs/js-solitaire/index.html",
      "args": [
        "800",
        "600"
      ],
      "gridX": 1,
      "gridY": 1
    },
    {
      "name": "3D Pinball",
      "icon": "win7_pinball.png",
      "type": "webapp",
      "url": "https://98.js.org/programs/pinball/space-cadet.html",
      "args": [
        "640",
        "620"
      ],
      "gridX": 1,
      "gridY": 2
    },

    {
      "name": "Screen Saver",
      "icon": "screensaver.png",
      "type": "screensaver",
      "gridX": 1,
      "gridY": 4
    },
    {
      "name": "TV",
      "icon": "win7_tv.png",
      "type": "tvfolder",
      "gridX": 0,
      "gridY": 7
    },
    {
      "name": "Clock",
      "icon": "win7_clock.png",
      "type": "clock",
      "gridX": 0,
      "gridY": 8
    }
  ],
  "fallbackIcon": "generic.png",

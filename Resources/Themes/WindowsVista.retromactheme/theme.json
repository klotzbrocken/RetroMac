    "com.apple.Keynote": "keynote-256.png",
    "com.apple.iWork.Keynote": "keynote-256.png",
    "com.microsoft.Word": "word-256.png",
    "com.microsoft.Excel": "excel-256.png",
    "com.microsoft.Powerpoint": "powerpoint-256.png",
    "com.microsoft.Outlook": "outlook-256.png",
    "com.microsoft.onenote.mac": "onenote-256.png",
    "com.google.Chrome": "chrome-256.png",
    "org.mozilla.firefox": "firefox-256.png",
    "com.apple.dt.Xcode": "xcode-128.png",
    "com.googlecode.iterm2": "iterm2-64.png",
    "com.spotify.client": "spotify-256.png",
    "org.videolan.vlc": "vlc-128.png",
    "com.adobe.Photoshop": "photoshop-256.png",
    "com.adobe.illustrator": "illustrator-256.png"
  },
  "desktopIconSize": 48,
  "screensaver": "pipes",
  "appearance": "light",

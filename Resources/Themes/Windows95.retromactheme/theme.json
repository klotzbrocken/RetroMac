{
  "schemaVersion": 2,
  "id": "com.retromac.microsoft.windows95",
  "family": {
    "id": "microsoft",
    "name": "Microsoft Windows",
    "order": 1
  },
  "release": {
    "label": "Windows 95",
    "year": 1995
  },
  "experienceLevel": "full",
  "chrome": {
    "style": "win98"
  },
  "chromeColors": {
    "activeTitle": "#000080",
    "titleText": "#FFFFFF",
    "inactiveTitle": "#808080",
    "inactiveTitleText": "#C0C0C0",
    "face": "#C0C0C0",
    "hilight": "#FFFFFF",
    "light": "#DFDFDF",
    "shadow": "#808080",
    "dkShadow": "#000000",
    "window": "#FFFFFF",
    "windowText": "#000000",
    "menu": "#C0C0C0",
    "menuText": "#000000",
    "selection": "#000080",
    "selectionText": "#FFFFFF"
  },
  "name": "Windows 95",
  "hideMenuBarDefault": true,
  "version": "1.0",
  "author": "RetroMac",
  "splashScreen": "splash.png",
  "splashVideo": "boot.mp4",
  "splashFullscreen": true,
  "wallpaper": "wallpaper-clouds.png",
  "wallpapers": [
    {
      "name": "Clouds",
      "file": "wallpaper-clouds.png"
    },
    {
      "name": "Classic Teal",
      "file": "wallpaper-teal.png"
    }
  ],
  "dock": {
    "height": 40,
    "iconSize": 28,
    "padding": 4,
    "spacing": 4,
    "cornerRadius": 0,
    "backgroundColor": "#C0C0C0FF",
    "backgroundImage": null,
    "backgroundImageMode": "tile",
    "borderColor": "#000000FF",
    "borderWidth": 0,
    "shadowEnabled": false,
    "shadowColor": "#00000000",
    "shadowRadius": 0,
    "bevelTopColor": "#FFFFFFFF",
    "bevelBottomColor": "#808080FF",
    "bevelWidth": 2,
    "orientation": "horizontal",
    "position": "bottom",
    "fullWidth": true,
    "startButton": true,
    "startButtonLabel": "Start",
    "startButtonIcon": "start.png",
    "startMenuStyle": "classic",
    "showQuickLaunch": false,
    "showClock": true
  },
  "icon": {
    "renderStyle": "pixelated",
    "reflectionEnabled": false,
    "reflectionOpacity": 0,
    "hoverScale": 1.0,
    "hoverAnimationDuration": 0.05
  },
  "indicator": {
    "style": "square",
    "color": "#000080",
    "size": 4,
    "offset": 3
  },
  "fallbackIcon": "generic.png",
  "defaultPreset": "crt-lite",
  "iconMappings": {
    "com.apple.finder": "finder.png",
    "com.apple.Safari": "ie.png",
    "com.apple.mail": "mail.png",
    "com.apple.Photos": "photos.png",
    "com.apple.MobileSMS": "messages.png",
    "com.apple.Notes": "notes.png",
    "com.apple.iCal": "calendar.png",
    "com.apple.systempreferences": "settings.png",
    "com.apple.Music": "music.png",
    "com.apple.Terminal": "terminal.png",
    "com.apple.AppStore": "appstore.png",
    "com.apple.Preview": "preview.png",
    "com.apple.TextEdit": "textedit.png",
    "com.apple.calculator": "calculator.png",
    "com.apple.Maps": "maps.png",
    "com.apple.AddressBook": "contacts.png",
    "com.apple.reminders": "reminders.png",
    "com.apple.iBooksX": "books.png",
    "com.apple.ActivityMonitor": "activitymonitor.png",
    "com.apple.archiveutility": "archive.png",
    "com.apple.dt.Xcode": "xcode.png",
    "com.microsoft.Word": "word.png",
    "com.microsoft.Excel": "excel.png",
    "com.microsoft.Powerpoint": "powerpoint.png",
    "org.gimp.gimp": "gimp.png",
    "org.videolan.vlc": "vlc.png",
    "com.apple.FaceTime": "facetime.png",
    "com.apple.clock": "clock.png",
    "com.apple.podcasts": "podcasts.png"
  },
  "desktopIconsSide": "left",
  "desktopIcons": [
    {
      "name": "My Computer",
      "icon": "computer.png",
      "type": "folder",
      "path": "/",
      "gridX": 0,
      "gridY": 0
    },
    {
      "name": "My Documents",
      "icon": "documents.png",
      "type": "folder",
      "path": "~/Documents",
      "gridX": 0,
      "gridY": 1
    },
    {
      "name": "Programs",
      "icon": "programsfolder.png",
      "type": "appfolder",
      "gridX": 0,
      "gridY": 2
    },
    {
      "name": "Internet Explorer",
      "icon": "ie.png",
      "type": "webapp",
      "url": "https://bored-win98.pisaucer.com/programs/explorer/index.html?address=https%3A%2F%2Fwww.amazon.com",
      "args": [
        "1020",
        "740"
      ],
      "gridX": 0,
      "gridY": 3
    },
    {
      "name": "Notepad",
      "icon": "notepadclassic.png",
      "type": "notepad",
      "gridX": 0,
      "gridY": 4
    },
    {
      "name": "Paint",
      "icon": "paint98.png",
      "type": "webapp",
      "url": "https://bored-win98.pisaucer.com/programs/jspaint/index.html",
      "args": [
        "920",
        "640"
      ],
      "gridX": 0,
      "gridY": 5
    },
    {
      "name": "Minesweeper",
      "icon": "mines.png",
      "type": "webapp",
      "url": "https://bored-win98.pisaucer.com/programs/minesweeper/index.html",
      "args": [
        "360",
        "460"
      ],
      "gridX": 0,
      "gridY": 6
    },
    {
      "name": "Solitaire",
      "icon": "solitaire.png",
      "type": "webapp",
      "url": "https://bored-win98.pisaucer.com/programs/js-solitaire/index.html",
      "args": [
        "800",
        "600"
      ],
      "gridX": 0,
      "gridY": 7
    },
    {
      "name": "CPU Monitor",
      "icon": "menu-sysguard.png",
      "type": "cpumonitor",
      "gridX": 1,
      "gridY": 0
    },
    {
      "name": "Clock",
      "icon": "clock.png",
      "type": "clock",
      "gridX": 1,
      "gridY": 1
    },
    {
      "name": "sheep.exe",
      "icon": "sheep.png",
      "type": "sheep",
      "gridX": 1,
      "gridY": 2
    },
    {
      "name": "Recycle Bin",
      "icon": "trash.png",
      "iconFull": "trash_full.png",
      "type": "trash",
      "gridX": 1,
      "gridY": 3
    },
    {
      "name": "Screen Saver",
      "icon": "screensaver.png",
      "type": "screensaver",
      "gridX": 1,
      "gridY": 4
    },
    {
      "name": "Calculator",
      "icon": "calculator.png",
      "type": "calculator",
      "gridX": 1,
      "gridY": 5
    },
    {
      "name": "TV",
      "icon": "menu-multimedia.png",
      "type": "tvfolder",
      "gridX": 0,
      "gridY": 8
    },
    {
      "name": "Fun Stuff (D:)",
      "icon": "cdrom.png",
      "type": "funstuff",
      "gridX": 1,
      "gridY": 6
    },
    {
      "name": "Defrag",
      "icon": "defrag.png",
      "type": "defrag",
      "gridX": 1,
      "gridY": 7
    }
  ],
  "desktopIconSize": 40,
  "screensaver": "flowerbox",
  "appearance": "light",
  "accentColor": "blue",
  "systemTweaks": [
    {
      "domain": "-g",
      "key": "NSConvolutionOverride1",
      "type": "float",
      "value": "2",
      "refresh": "Finder"
    },
    {
      "domain": "-g",
      "key": "NSSplitViewItemGlassMinimumCornerRadius",
      "type": "float",
      "value": "2",
      "refresh": "Finder"
    }
  ]
}

    "com.apple.AddressBook": "contacts-256.png",
    "com.apple.reminders": "reminders-256.png",
    "com.apple.Preview": "preview-256.png",
    "com.apple.TextEdit": "textedit-32.png",
    "com.apple.Pages": "pages-256.png",
    "com.apple.iWork.Pages": "pages-256.png",
    "com.apple.Numbers": "numbers-256.png",

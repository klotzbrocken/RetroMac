+// --- RetroMac chrome drawing (SDL_Renderer primitives, in logical coordinates) -------------
+static inline void rmRect(int x, int y, int w, int h, Uint8 r, Uint8 g, Uint8 b)
+{
+	SDL_SetRenderDrawColor(TheRenderer, r, g, b, 255);
+	SDL_Rect rc = { x, y, w, h };
+	SDL_RenderFillRect(TheRenderer, &rc);
+}
+// Vertical top→bottom gradient across [0,W) × [y0,y0+h).
+static inline void rmVGrad(int W, int y0, int h,
+                           Uint8 r0, Uint8 g0, Uint8 b0, Uint8 r1, Uint8 g1, Uint8 b1)
+{
+	for (int i = 0; i < h; ++i) {
+		float f = h > 1 ? (float)i / (h - 1) : 0.f;
+		rmRect(0, y0 + i, W, 1,
+		       (Uint8)(r0 + (r1 - r0) * f), (Uint8)(g0 + (g1 - g0) * f), (Uint8)(b0 + (b1 - b0) * f));
+	}
+}
+
+// Draw the themed title bar into the top RetroMacChromeH logical rows. No-op when the chrome is
+// off (windowed-with-theme only). Runs on EVERY present, so it can never be left stale.
+static void RetroMacDrawChrome(SDL_Renderer * /*ren*/)
+{
+	const int H = RetroMacChromeH;
+	if (H <= 0) return;
+	const int W = Video.Width;
+	const char *t = RetroMacTheme;
+	auto is = [&](const char *k) { return strcmp(t, k) == 0; };
+
+	const int bs = 11;                       // control-box side
+	SDL_Rect close = { 7, (H - bs) / 2, bs, bs };
+	RetroMacCloseBox = close;
+
+	if (is("macos9") || is("macos6")) {
+		// Platinum: #dadada bar, centred 12px pinstripe band (white / #737373), black underline.
+		rmRect(0, 0, W, H, 0xda, 0xda, 0xda);
+		for (int y = (H - 12) / 2; y < (H - 12) / 2 + 12; y += 2) {
+			rmRect(2, y, W - 4, 1, 0xff, 0xff, 0xff);
+			rmRect(2, y + 1, W - 4, 1, 0x73, 0x73, 0x73);
+		}
+		rmRect(0, H - 1, W, 1, 0x00, 0x00, 0x00);
+		// concave close box: #222 outline, light face
+		rmRect(close.x, close.y, bs, bs, 0x22, 0x22, 0x22);
+		rmRect(close.x + 1, close.y + 1, bs - 2, bs - 2, 0xcc, 0xcc, 0xcc);
+		rmRect(close.x + 2, close.y + 2, bs - 4, bs - 4, 0xaa, 0xaa, 0xaa);
+	} else if (is("winxp") || is("win7")) {
+		// Luna blue title bar (vertical gradient), red close box with an ×.
+		rmVGrad(W, 0, H, 0x09, 0x97, 0xFF, 0x00, 0x3D, 0xD2);
+		SDL_Rect c = { W - 24, (H - 16) / 2, 20, 16 };
+		RetroMacCloseBox = c;
+		rmRect(c.x, c.y, c.w, c.h, 0xE3, 0x5F, 0x44);
+		SDL_SetRenderDrawColor(TheRenderer, 255, 255, 255, 255);
+		SDL_RenderDrawLine(TheRenderer, c.x + 6, c.y + 5, c.x + 13, c.y + 11);
+		SDL_RenderDrawLine(TheRenderer, c.x + 13, c.y + 5, c.x + 6, c.y + 11);
+	} else if (is("win98")) {
+		// Navy→blue horizontal gradient, grey close box with a black ×.
+		for (int x = 0; x < W; ++x) {
+			float f = (float)x / (W ? W : 1);
+			SDL_SetRenderDrawColor(TheRenderer, (Uint8)(0x00 + 0x10 * f),
+			                       (Uint8)(0x00 + 0x85 * f), (Uint8)(0x7b + (0xd2 - 0x7b) * f), 255);
+			SDL_RenderDrawLine(TheRenderer, x, 0, x, H - 1);
+		}
+		SDL_Rect c = { W - 22, (H - 16) / 2, 18, 16 };
+		RetroMacCloseBox = c;
+		rmRect(c.x, c.y, c.w, c.h, 0xc4, 0xc4, 0xc4);          // face
+		rmRect(c.x, c.y, c.w, 1, 0xff, 0xff, 0xff);            // top hilite
+		rmRect(c.x, c.y, 1, c.h, 0xff, 0xff, 0xff);            // left hilite
+		rmRect(c.x, c.y + c.h - 1, c.w, 1, 0x00, 0x00, 0x00);  // bottom shadow
+		rmRect(c.x + c.w - 1, c.y, 1, c.h, 0x00, 0x00, 0x00);  // right shadow
+		SDL_SetRenderDrawColor(TheRenderer, 0, 0, 0, 255);
+		SDL_RenderDrawLine(TheRenderer, c.x + 5, c.y + 5, c.x + 12, c.y + 11);
+		SDL_RenderDrawLine(TheRenderer, c.x + 12, c.y + 5, c.x + 5, c.y + 11);
+	} else if (is("macosx")) {
+		// Aqua brushed grey; three gel dots (approximated as small rounded squares).
+		rmVGrad(W, 0, H, 0xfa, 0xfa, 0xfa, 0xbc, 0xbc, 0xbc);
+		rmRect(0, H - 1, W, 1, 0x88, 0x88, 0x88);
+		const int d = 12, cy = (H - d) / 2;
+		SDL_Rect r = { 9, cy, d, d };          RetroMacCloseBox = r;
+		rmRect(r.x + 1, r.y, d - 2, d, 0xd5, 0x4f, 0x36);          // red (close)
+		rmRect(9 + d + 6 + 1, cy, d - 2, d, 0xe6, 0xb2, 0x2e);     // yellow
+		rmRect(9 + 2 * (d + 6) + 1, cy, d - 2, d, 0x3a, 0xa9, 0x0e); // green
+	} else {
+		// BeOS / Maiks Favourite / default: yellow tab strip, brown close box.
+		rmRect(0, 0, W, H, 0xf2, 0xbd, 0x23);
+		rmRect(0, H - 1, W, 1, 0x2a, 0x2a, 0x2a);
+		rmRect(close.x, close.y, bs, bs, 0x6f, 0x5a, 0x10);
+		rmRect(close.x + 1, close.y + 1, bs - 2, bs - 2, 0xfb, 0xe2, 0x7e);
+	}
+	SDL_SetRenderDrawColor(TheRenderer, 0, 0, 0, 255);
+}
+
+// The one present all render paths funnel through: chrome is guaranteed drawn last, then flip.
+void RetroMacPresent(SDL_Renderer *ren)
+{
+	RetroMacDrawChrome(ren);
+	SDL_RenderPresent(ren);
+}
+
+// Content viewport (logical coords) reserved below the chrome. When the chrome is off this is
+// the whole logical area, so callers can copy into it unconditionally.
+SDL_Rect RetroMacContentRect()
+{
+	SDL_Rect r = { 0, RetroMacChromeH, Video.Width,
+	               (int)std::lround(Video.Height * Video.VerticalPixelSize) };
+	return r;
+}
+
+// Left-click in the chrome strip: quit if it hit the close box (push SDL_QUIT → normal exit).
+static void RetroMacChromeClick(int x, int y)
+{
+	if (x >= RetroMacCloseBox.x && x < RetroMacCloseBox.x + RetroMacCloseBox.w &&
+	    y >= RetroMacCloseBox.y && y < RetroMacCloseBox.y + RetroMacCloseBox.h) {
+		SDL_Event q; q.type = SDL_QUIT; SDL_PushEvent(&q);
+	}
+}
+

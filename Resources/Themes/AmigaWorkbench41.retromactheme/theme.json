{
  "schemaVersion": 2,
  "id": "com.retromac.amiga.workbench41",
  "family": {
    "id": "amiga",
    "name": "Amiga",
    "order": 6
  },
  "release": {
    "label": "Workbench 4.1",
    "year": 2008
  },
  "experienceLevel": "full",
  "chrome": {
    "style": "amiga"
  },
  "finder": "amiga",
  "name": "Amiga Workbench 4.1",
  "version": "1.0",
  "author": "RetroMac",
  "wallpaper": "wallpaper-2008.jpg",
  "wallpapers": [
    {
      "name": "Workbench 2008 (reconstruction)",
      "file": "wallpaper-2008.jpg"
    },
    {
      "name": "Workbench Gray (Gradient)",
      "file": "wallpaper.png"
    },
    {
      "name": "Workbench Gray (Flat)",
      "file": "wallpaper-flat.png"
    }
  ],
  "splashScreen": "boot-splash.jpg",
  "splashFullscreen": true,
  "boot": {
    "firmware": "uboot"
  },
  "dock": {
    "height": 64,
    "iconSize": 40,
    "padding": 16,
    "spacing": 12,
    "cornerRadius": 0,
    "backgroundColor": "#D2D2D4E8",
    "backgroundImage": null,
    "backgroundImageMode": "tile",
    "borderColor": "#6E6E72FF",
    "borderWidth": 1,
    "shadowEnabled": false,
    "shadowColor": "#00000000",
    "shadowRadius": 0,
    "bevelTopColor": "#FFFFFFFF",
    "bevelBottomColor": "#8C8D90FF",
    "bevelWidth": 1,
    "orientation": "horizontal",
    "position": "bottom",
    "alignment": "right",
    "fullWidth": false,
    "showClock": false,
    "showTrash": false,
    "magnification": false,
    "edgeOffset": 0,
    "labelsBelow": true,
    "labelNames": {
      "com.apple.finder": "Workbench",
      "com.apple.TextEdit": "NotePad",
      "com.apple.Preview": "MultiView",
      "com.apple.Terminal": "Shell",
      "com.apple.archiveutility": "Unarc",
      "com.apple.systempreferences": "Prefs"
    }
  },
  "icon": {
    "renderStyle": "smooth",
    "reflectionEnabled": false,
    "reflectionOpacity": 0,
    "hoverScale": 1.0,
    "hoverAnimationDuration": 0.05
  },
  "indicator": {
    "style": "none",
    "color": "#000000",
    "size": 0,
    "offset": 0
  },
  "desktopIcons": [
    {
      "name": "System",
      "icon": "harddrive-system.png",
      "type": "folder",
      "path": "SYS:",
      "gridX": 0,
      "gridY": 0
    },
    {
      "name": "Work",
      "icon": "floppy.png",
      "type": "folder",
      "path": "~",
      "gridX": 0,
      "gridY": 1
    },
    {
      "name": "RAM Disk",
      "icon": "ramdisk.png",
      "type": "folder",
      "path": "RAM:",
      "gridX": 0,
      "gridY": 2
    },
    {
      "name": "Volumes",
      "icon": "harddrive.png",
      "type": "volumes",
      "gridX": 0,
      "gridY": 3
    }
  ],
  "desktopIconsSide": "left",
  "desktopIconSize": 48,
  "desktopLabel": {
    "font": "DejaVuSans-Oblique",
    "size": 12,
    "color": "#000000"
  },
  "fallbackIcon": "tool.png",
  "defaultPreset": "lcd-sharp-lite",
  "hideMenuBarDefault": true,
  "iconMappings": {
    "com.apple.finder": "drawer-system.png",
    "com.apple.TextEdit": "notepad.png",
    "com.apple.Preview": "multiview.png",
    "com.apple.Terminal": "shell.png",
    "com.apple.archiveutility": "unarc.png",
    "com.apple.systempreferences": "drawer-prefs.png"
  },
  "appearance": "light",
  "accentColor": "orange"
}

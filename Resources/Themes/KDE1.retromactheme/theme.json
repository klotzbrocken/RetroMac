{
  "schemaVersion": 2,
  "id": "com.retromac.kde.kde1",
  "minAppVersion": "3.0",
  "family": {
    "id": "kde",
    "name": "KDE",
    "order": 14
  },
  "release": {
    "label": "KDE 1.0",
    "year": 1998
  },
  "experienceLevel": "full",
  "chrome": {
    "style": "kde"
  },
  "name": "KDE 1.0",
  "version": "1.0",
  "author": "RetroMac",
  "wallpaper": "wallpaper.png",
  "wallpapers": [
    {
      "name": "One",
      "file": "wallpaper.png"
    },
    {
      "name": "Two",
      "file": "wallpaper-two.png"
    },
    {
      "name": "Three",
      "file": "ruins.jpg",
      "tiled": true
    },
    {
      "name": "Four",
      "file": "water01.jpg",
      "tiled": true
    }
  ],
  "dock": {
    "height": 64,
    "iconSize": 48,
    "padding": 8,
    "spacing": 0,
    "cornerRadius": 0,
    "backgroundColor": "#C0C0C0FF",
    "backgroundImage": null,
    "backgroundImageMode": "tile",
    "borderColor": "#000000FF",
    "borderWidth": 1,
    "shadowEnabled": false,
    "shadowColor": "#00000000",
    "shadowRadius": 0,
    "bevelTopColor": "#FFFFFFFF",
    "bevelBottomColor": "#808080FF",
    "bevelWidth": 2,
    "orientation": "horizontal",
    "position": "bottom",
    "fullWidth": true,
    "startButton": false,
    "showClock": false,
    "magnification": false,
    "showTrash": false,
    "showGrip": false,
    "alignment": "left",
    "edgeOffset": 0,
    "dockStyle": "none"
  },
  "icon": {
    "renderStyle": "pixelated",
    "reflectionEnabled": false,
    "reflectionOpacity": 0,
    "hoverScale": 1.0,
    "hoverAnimationDuration": 0.1
  },
  "indicator": {
    "style": "dot",
    "color": "#000000",
    "size": 4,
    "offset": 3
  },
  "fallbackIcon": "app_generic.png",
  "desktopIcons": [
    {
      "name": "Home",
      "icon": "kfm_home.png",
      "type": "folder",
      "path": "~",
      "gridX": 0,
      "gridY": 0
    },
    {
      "name": "Trash",
      "icon": "kfm_trash.png",
      "iconFull": "kfm_fulltrash.png",
      "type": "trash",
      "gridX": 0,
      "gridY": 1
    }
  ],
  "desktopLabel": {
    "font": "Helvetica",
    "size": 12,
    "color": "#FFFFFF"
  },
  "iconMappings": {
    "com.anthropic.claudefordesktop": "app_claude.png",
    "com.apple.FaceTime": "app_meeting.png",
    "com.apple.MobileSMS": "app_messages.png",
